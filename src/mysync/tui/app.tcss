Screen {
    layout: vertical;
}

#job-info, #jobs-info {
    padding: 0 1;
    height: auto;
    background: $boost;
}

#filters {
    height: auto;
    padding: 0 1;
}

#filters Checkbox {
    border: none;
    padding: 0 1;
    height: 1;
    margin-right: 1;
}

#plan, #jobs, #select-tree {
    height: 1fr;
}

#summary, #jobs-errors {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $boost;
}

.buttons {
    height: auto;
    padding: 0 1;
}

.buttons Button {
    margin-right: 1;
    min-width: 8;
}

.buttons Button.small {
    min-width: 6;
}

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.dialog.wide {
    width: 90%;
    max-width: 120;
}

.dialog.tall {
    height: 90%;
}

.dialog-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

.dialog-body {
    margin-bottom: 1;
}

.dialog-scroll {
    height: auto;
    max-height: 30;
}

.dialog Input, .dialog Select {
    margin-bottom: 1;
}

.error {
    color: $error;
}

SyncScreen ProgressBar {
    margin-bottom: 1;
}

SyncScreen #log {
    height: 1fr;
    border: round $primary-darken-2;
}

#current, #stats {
    height: auto;
}
